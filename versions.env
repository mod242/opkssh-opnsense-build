# Upstream opkssh release that is built. Renovate updates OPKSSH_VERSION and OPKSSH_COMMIT together.
# renovate: datasource=github-tags depName=openpubkey/opkssh
OPKSSH_VERSION=v0.20.0
OPKSSH_COMMIT=9dd6bfd7658df7b861d0f37ff3f34cd2da9cf3ed
# Revision of patch/build for the same upstream version; release tag is <OPKSSH_VERSION>-freebsd.<RELEASE_REVISION>.
# Reset to 1 when OPKSSH_VERSION changes.
RELEASE_REVISION=1
